<?xml version="1.0" encoding="UTF-8"?>
<!-- CharSelect installer: the plugin itself, plus the select screen's location.
     Each choice installs a CharSelect.ini that differs only in sLobbyCell
     (generated by cmake/StageFomod.cmake from fomod/locations.txt), with a
     screenshot of it from fomod\images\<folder>.jpg. -->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://qconsulting.ca/fo3/ModConfig5.0.xsd">
	<moduleName>Character Select</moduleName>
	<requiredInstallFiles>
		<folder source="Core" destination="" />
	</requiredInstallFiles>
	<installSteps order="Explicit">
		<installStep name="Location">
			<optionalFileGroups order="Explicit">
				<group name="Select screen location" type="SelectExactlyOne">
					<plugins order="Explicit">
						<plugin name="The Bannered Mare">
							<description></description>
							<image path="fomod\images\BanneredMare.jpg" />
							<files>
								<folder source="Locations\BanneredMare" destination="" />
							</files>
							<typeDescriptor>
								<type name="Recommended" />
							</typeDescriptor>
						</plugin>
						<plugin name="The Ragged Flagon">
							<description></description>
							<image path="fomod\images\RaggedFlagon.jpg" />
							<files>
								<folder source="Locations\RaggedFlagon" destination="" />
							</files>
							<typeDescriptor>
								<type name="Optional" />
							</typeDescriptor>
						</plugin>
						<plugin name="Sky Haven Temple">
							<description></description>
							<image path="fomod\images\SkyHavenTemple.jpg" />
							<files>
								<folder source="Locations\SkyHavenTemple" destination="" />
							</files>
							<typeDescriptor>
								<type name="Optional" />
							</typeDescriptor>
						</plugin>
						<plugin name="High Hrothgar">
							<description></description>
							<image path="fomod\images\HighHrothgar.jpg" />
							<files>
								<folder source="Locations\HighHrothgar" destination="" />
							</files>
							<typeDescriptor>
								<type name="Optional" />
							</typeDescriptor>
						</plugin>
						<plugin name="Sovngarde">
							<description></description>
							<image path="fomod\images\Sovngarde.jpg" />
							<files>
								<folder source="Locations\Sovngarde" destination="" />
							</files>
							<typeDescriptor>
								<type name="Optional" />
							</typeDescriptor>
						</plugin>
					</plugins>
				</group>
			</optionalFileGroups>
		</installStep>
	</installSteps>
</config>
