<?xml version="1.0" encoding="UTF-8"?>
<!-- CharSelect installer: the plugin itself, plus two choices, the select
     screen's location and when it replaces the main menu. Together they pick
     one CharSelect.ini, Locations\<location>\<main menu choice>, generated
     by cmake/StageFomod.cmake from fomod/locations.txt and fomod/mainmenu.txt.
     Each location shows a screenshot from fomod\images\<folder>.jpg. -->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://qconsulting.ca/fo3/ModConfig5.0.xsd">
	<moduleName>Character Select</moduleName>
	<requiredInstallFiles>
		<folder source="Core" destination="" />
	</requiredInstallFiles>
	<installSteps order="Explicit">
		<installStep name="Location">
			<optionalFileGroups order="Explicit">
				<group name="Select screen location" type="SelectExactlyOne">
					<plugins order="Explicit">
						<plugin name="The Bannered Mare">
							<description></description>
							<image path="fomod\images\BanneredMare.jpg" />
							<conditionFlags>
								<flag name="location">BanneredMare</flag>
							</conditionFlags>
							<typeDescriptor>
								<type name="Recommended" />
							</typeDescriptor>
						</plugin>
						<plugin name="The Ragged Flagon">
							<description></description>
							<image path="fomod\images\RaggedFlagon.jpg" />
							<conditionFlags>
								<flag name="location">RaggedFlagon</flag>
							</conditionFlags>
							<typeDescriptor>
								<type name="Optional" />
							</typeDescriptor>
						</plugin>
						<plugin name="Sky Haven Temple">
							<description></description>
							<image path="fomod\images\SkyHavenTemple.jpg" />
							<conditionFlags>
								<flag name="location">SkyHavenTemple</flag>
							</conditionFlags>
							<typeDescriptor>
								<type name="Optional" />
							</typeDescriptor>
						</plugin>
						<plugin name="High Hrothgar">
							<description></description>
							<image path="fomod\images\HighHrothgar.jpg" />
							<conditionFlags>
								<flag name="location">HighHrothgar</flag>
							</conditionFlags>
							<typeDescriptor>
								<type name="Optional" />
							</typeDescriptor>
						</plugin>
						<plugin name="Sovngarde">
							<description></description>
							<image path="fomod\images\Sovngarde.jpg" />
							<conditionFlags>
								<flag name="location">Sovngarde</flag>
							</conditionFlags>
							<typeDescriptor>
								<type name="Optional" />
							</typeDescriptor>
						</plugin>
					</plugins>
				</group>
			</optionalFileGroups>
		</installStep>
		<installStep name="Main menu">
			<optionalFileGroups order="Explicit">
				<group name="When to show the lobby" type="SelectExactlyOne">
					<plugins order="Explicit">
						<plugin name="Always">
							<description>The lobby replaces Skyrim's main menu, when the game starts and whenever you go back to it.</description>
							<conditionFlags>
								<flag name="mainmenu">Startup</flag>
							</conditionFlags>
							<typeDescriptor>
								<type name="Recommended" />
							</typeDescriptor>
						</plugin>
						<plugin name="When going back to the main menu">
							<description>The normal main menu when the game starts. Going back to the main menu from a game opens the lobby instead. F7 opens it from the main menu any time.</description>
							<conditionFlags>
								<flag name="mainmenu">Return</flag>
							</conditionFlags>
							<typeDescriptor>
								<type name="Optional" />
							</typeDescriptor>
						</plugin>
						<plugin name="Only with F7">
							<description>Always the normal main menu. Press F7 there to open the lobby.</description>
							<conditionFlags>
								<flag name="mainmenu">Hotkey</flag>
							</conditionFlags>
							<typeDescriptor>
								<type name="Optional" />
							</typeDescriptor>
						</plugin>
					</plugins>
				</group>
			</optionalFileGroups>
		</installStep>
	</installSteps>
	<conditionalFileInstalls>
		<patterns>
			<pattern>
				<dependencies operator="And">
					<flagDependency flag="location" value="BanneredMare" />
					<flagDependency flag="mainmenu" value="Startup" />
				</dependencies>
				<files>
					<folder source="Locations\BanneredMare\Startup" destination="" />
				</files>
			</pattern>
			<pattern>
				<dependencies operator="And">
					<flagDependency flag="location" value="BanneredMare" />
					<flagDependency flag="mainmenu" value="Return" />
				</dependencies>
				<files>
					<folder source="Locations\BanneredMare\Return" destination="" />
				</files>
			</pattern>
			<pattern>
				<dependencies operator="And">
					<flagDependency flag="location" value="BanneredMare" />
					<flagDependency flag="mainmenu" value="Hotkey" />
				</dependencies>
				<files>
					<folder source="Locations\BanneredMare\Hotkey" destination="" />
				</files>
			</pattern>
			<pattern>
				<dependencies operator="And">
					<flagDependency flag="location" value="RaggedFlagon" />
					<flagDependency flag="mainmenu" value="Startup" />
				</dependencies>
				<files>
					<folder source="Locations\RaggedFlagon\Startup" destination="" />
				</files>
			</pattern>
			<pattern>
				<dependencies operator="And">
					<flagDependency flag="location" value="RaggedFlagon" />
					<flagDependency flag="mainmenu" value="Return" />
				</dependencies>
				<files>
					<folder source="Locations\RaggedFlagon\Return" destination="" />
				</files>
			</pattern>
			<pattern>
				<dependencies operator="And">
					<flagDependency flag="location" value="RaggedFlagon" />
					<flagDependency flag="mainmenu" value="Hotkey" />
				</dependencies>
				<files>
					<folder source="Locations\RaggedFlagon\Hotkey" destination="" />
				</files>
			</pattern>
			<pattern>
				<dependencies operator="And">
					<flagDependency flag="location" value="SkyHavenTemple" />
					<flagDependency flag="mainmenu" value="Startup" />
				</dependencies>
				<files>
					<folder source="Locations\SkyHavenTemple\Startup" destination="" />
				</files>
			</pattern>
			<pattern>
				<dependencies operator="And">
					<flagDependency flag="location" value="SkyHavenTemple" />
					<flagDependency flag="mainmenu" value="Return" />
				</dependencies>
				<files>
					<folder source="Locations\SkyHavenTemple\Return" destination="" />
				</files>
			</pattern>
			<pattern>
				<dependencies operator="And">
					<flagDependency flag="location" value="SkyHavenTemple" />
					<flagDependency flag="mainmenu" value="Hotkey" />
				</dependencies>
				<files>
					<folder source="Locations\SkyHavenTemple\Hotkey" destination="" />
				</files>
			</pattern>
			<pattern>
				<dependencies operator="And">
					<flagDependency flag="location" value="HighHrothgar" />
					<flagDependency flag="mainmenu" value="Startup" />
				</dependencies>
				<files>
					<folder source="Locations\HighHrothgar\Startup" destination="" />
				</files>
			</pattern>
			<pattern>
				<dependencies operator="And">
					<flagDependency flag="location" value="HighHrothgar" />
					<flagDependency flag="mainmenu" value="Return" />
				</dependencies>
				<files>
					<folder source="Locations\HighHrothgar\Return" destination="" />
				</files>
			</pattern>
			<pattern>
				<dependencies operator="And">
					<flagDependency flag="location" value="HighHrothgar" />
					<flagDependency flag="mainmenu" value="Hotkey" />
				</dependencies>
				<files>
					<folder source="Locations\HighHrothgar\Hotkey" destination="" />
				</files>
			</pattern>
			<pattern>
				<dependencies operator="And">
					<flagDependency flag="location" value="Sovngarde" />
					<flagDependency flag="mainmenu" value="Startup" />
				</dependencies>
				<files>
					<folder source="Locations\Sovngarde\Startup" destination="" />
				</files>
			</pattern>
			<pattern>
				<dependencies operator="And">
					<flagDependency flag="location" value="Sovngarde" />
					<flagDependency flag="mainmenu" value="Return" />
				</dependencies>
				<files>
					<folder source="Locations\Sovngarde\Return" destination="" />
				</files>
			</pattern>
			<pattern>
				<dependencies operator="And">
					<flagDependency flag="location" value="Sovngarde" />
					<flagDependency flag="mainmenu" value="Hotkey" />
				</dependencies>
				<files>
					<folder source="Locations\Sovngarde\Hotkey" destination="" />
				</files>
			</pattern>
		</patterns>
	</conditionalFileInstalls>
</config>
